APP_NAME=DistroFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

# Railway will auto-set these via MySQL plugin
DB_CONNECTION=mysql
DB_HOST=${MYSQL_HOST:-127.0.0.1}
DB_PORT=${MYSQL_PORT:-3306}
DB_DATABASE=${MYSQL_DATABASE:-distroflow}
DB_USERNAME=${MYSQL_USERNAME:-root}
DB_PASSWORD=${MYSQL_PASSWORD:-}

# Railway Redis plugin (optional)
REDIS_HOST=${REDIS_HOST:-127.0.0.1}
REDIS_PASSWORD=${REDIS_PASSWORD:-null}
REDIS_PORT=${REDIS_PORT:-6379}

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=your-frontend.vercel.app

MAIL_MAILER=smtp
MAIL_HOST=${MAIL_HOST:-smtp.sendgrid.net}
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_ENCODING=utf-8
MAIL_FROM_ADDRESS=noreply@distroflow.com
MAIL_FROM_NAME="${APP_NAME}"

# SMS Provider (Twilio - primary)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SMS Provider (Vonage - failover)
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_FROM=

# SMS Provider (VictoryLink - Egypt gateway fallback)
VICTORYLINK_USERNAME=
VICTORYLINK_PASSWORD=
VICTORYLINK_SENDER=

# WhatsApp (Twilio or WATI)
WHATSAPP_PROVIDER=twilio
WHATSAPP_TWILIO_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=

# Pusher / Reverb (WebSocket)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_WS_HOST=
VITE_WS_PORT=6001
VITE_WS_SCHEME=https

# Tax config (Egypt)
TAX_REGISTRATION_NUMBER=123-456-789
TAX_RATE=0.14
COMMERCIAL_REGISTER=12345
COMPANY_ADDRESS="Cairo, Egypt"
COMPANY_PHONE="+20 2 12345678"
